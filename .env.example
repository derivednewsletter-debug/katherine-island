# Katherine's Island — environment variables
# Copy to .env for local development (optional; the game works offline
# without it — saves just stay in localStorage).
#
# Neon pooled connection string (server-only, never exposed to the client).
# Get it from the Neon dashboard → Connection Details → Pooled connection
# string, or run: neonctl connection-string <branch> --pooled
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/dbname?sslmode=require"
